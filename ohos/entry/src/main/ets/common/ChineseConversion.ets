  private static ensureTable(): Map<string, string> {
    if (ChineseConversion.table !== null) {
      return ChineseConversion.table;
    }
    const map: Map<string, string> = new Map<string, string>();
    let maxLen: number = 1;
    const entries: string[] = ChineseConversion.PACKED.split(';');
    for (const entry of entries) {
      const sep: number = entry.indexOf('=');
      if (sep <= 0) {
        continue;
      }
      const k: string = entry.substring(0, sep);
      const v: string = entry.substring(sep + 1);
      if (v.length === 0 || map.has(k)) {
        continue;
      }
      map.set(k, v);
      if (k.length > maxLen) {
        maxLen = k.length;
      }
    }
    ChineseConversion.table = map;
    ChineseConversion.maxKeyLen = maxLen;
    return map;
  }

  /** 繁体→简体（开关关/空串原样返回）；贪心最长匹配，非 CJK 字符逐字原样 */
  static t2s(text: string): string {
    if (!ChineseConversion.enabled || text.length === 0) {
      return text;
    }
    const map: Map<string, string> = ChineseConversion.ensureTable();
    const maxLen: number = ChineseConversion.maxKeyLen;
    const n: number = text.length;
    let out: string = '';
    let i: number = 0;
    while (i < n) {
      const code: number = text.charCodeAt(i);
      if (code < 0x3400 || code > 0x9FFF) {
        out += text.charAt(i);
        i++;
        continue;
      }
      let matched: string = '';
      let matchedLen: number = 0;
      const upper: number = Math.min(maxLen, n - i);
      for (let len: number = upper; len >= 1; len--) {
        const v: string | undefined = map.get(text.substring(i, i + len));
        if (v !== undefined) {
          matched = v;
          matchedLen = len;
          break;
        }
      }
      if (matchedLen > 0) {
        out += matched;
        i += matchedLen;
      } else {
        out += text.charAt(i);
        i++;
      }
    }
    return out;
  }
